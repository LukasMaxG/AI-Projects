rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }
    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string &&
        request.resource.data[field].size() >= minLen &&
        request.resource.data[field].size() <= maxLen;
    }
    
    // Global wines cache
    match /wines/{wineId} {
      // Anyone can read the global cache
      allow read: if true;
      // Authenticated users can create or update cache entries
      allow create, update: if isAuthenticated() 
                    && hasRequiredFields(['id', 'name', 'vintage', 'searchKey'])
                    && validStringLength('name', 1, 250)
                    && validStringLength('searchKey', 1, 250);
      // No deletes to the global cache to prevent abuse
      allow delete: if false;
    }

    // User's personal data
    match /users/{userId} {
      // Allow read/write only to the owner
      allow read, write: if isOwner(userId);
      
      match /cellar/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && hasRequiredFields(['id', 'wine', 'quantity', 'addedAt'])
                      && request.resource.data.quantity is number
                      && request.resource.data.quantity >= 0;
        allow update: if isOwner(userId)
                      && hasRequiredFields(['id', 'wine', 'quantity', 'addedAt'])
                      && request.resource.data.quantity is number
                      && request.resource.data.quantity >= 0;
        allow delete: if isOwner(userId);
      }
      
      match /history/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
                      && hasRequiredFields(['id', 'wine', 'scannedAt']);
        allow update: if isOwner(userId)
                      && hasRequiredFields(['id', 'wine', 'scannedAt']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
